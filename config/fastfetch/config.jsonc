{
    "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
    "logo": {
        "source": "~/.config/fastfetch/roxy-mushoku-tensei-2.png",
        "type": "kitty-direct",
        "height": 12,
        "width": 20,
        "padding": {
            "top": 0,
            "left": 3
        }
    },
    "display": {
        "separator": "  "
    },
    "modules": [
        "break",
        "break",
        "title",
        {
            "type": "os",
            "key": "os    ",
            "keyColor": "33"
        },
        {
            "type": "kernel",
            "key": "kernel",
            "keyColor": "33"
        },
        {
            "type": "cpu",
            "format": "{1}",
            "key": "cpu   ",
            "keyColor": "33"
        },
        {
            "type": "gpu",
            "key": "gpu   ",
            "keyColor": "33"
        },
        {
            "type": "packages",
            "format": "{}",
            "key": "pkgs  ",
            "keyColor": "33"
        },
        {
            "type": "uptime",
            "format": "{2}h {3}m",
            "key": "uptime",
            "keyColor": "33"
        },
        {
            "type": "memory",
            "key": "memory",
            "keyColor": "33"
        },
        {
            "type": "disk",
            "key": "disk  ",
            "keyColor": "33"
        },
        "break"
    ]
}
