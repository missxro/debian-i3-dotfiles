#!/usr/bin/env python3
"""Start picom; fall back to the xrender backend when OpenGL is software-rendered."""
import os
from pathlib import Path
import subprocess
import sys


def main():
    config = Path(os.environ.get('XDG_CONFIG_HOME', str(Path.home() / '.config'))) / 'picom/picom.conf'
    argv = ['picom', '--config', str(config)]
    try:
        result = subprocess.run(argv + ['--diagnostics'], capture_output=True, text=True,
                                timeout=15)
        report = result.stdout if result.returncode == 0 else ''
    except (OSError, subprocess.SubprocessError):
        report = ''  # Unknown renderer: keep the configured backend.
    # The glx backend on llvmpipe (e.g. VMs without 3D) leaves every window black.
    if '* Accelerated: 0' in report:
        print('picom-launch: software OpenGL detected; using the xrender backend.', file=sys.stderr)
        argv += ['--backend', 'xrender']
    try:
        os.execvp(argv[0], argv)
    except OSError as error:
        print(f'picom-launch: {error}', file=sys.stderr)
        return 1


if __name__ == '__main__':
    raise SystemExit(main())
